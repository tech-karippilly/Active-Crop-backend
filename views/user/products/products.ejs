<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>



    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="./style.css">
</head>

<body>

    <main>
        <section class="header-section">
            <header class="bg-light py-2">
                <div class="container">
                    <div class="row justify-content-end align-items-center">
                        <div class="col-auto">
                            <a href="https://wa.me/8078599537" class="text-dark" target="_blank">
                                <i class="fab fa-whatsapp"></i> 8078599537
                            </a>
                        </div>
                        <div class="col-auto">
                            <a href="tel:8078599537" class="text-dark">
                                <i class="fas fa-headset"></i> 8078599537
                            </a>
                        </div>
                        <div class="col-auto">
                            <a href="chat.html" class="text-dark">
                                <i class="fas fa-comments"></i> Chat
                            </a>
                        </div>
                        <div class="col-auto">
                            <a href="login.html" class="btn btn-primary">Login</a>
                        </div>
                    </div>
                </div>
            </header>
            <div class="bg-light py-3">
                <div class="container">
                    <div class="row justify-content-between align-items-center">
                        <div class="col-auto">
                            ACTIVE CROP
                        </div>
                        <div class="col-auto">
                            <form class="form-inline">
                                <input class="form-control mr-2" type="search" placeholder="Search" aria-label="Search">
                                <button class="btn btn-outline-success mr-2" type="submit">Search</button>
                                <a href="cart.html" class="btn btn-outline-primary">
                                    <i class="fas fa-shopping-cart"></i> Cart
                                </a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="body-section">
            <div class="container mt-5">
                <h1 class="mb-4">Active Crop - Products</h1>
                <div class="row">
                    <% data.forEach(item=> { %>
                        <div class="col-md-3 mb-4">
                            <div class="card" onclick="viewProduct('<%= item._id %>')">
                                <img src="<%= item.images['0'] %>" class="card-img-top product-img"
                                    alt="<%= item.product_name %>">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <%= item.product_name %>
                                    </h5>
                                    <p class="card-text">
                                        <%= item.description %>
                                    </p>
                                    <p class="card-text"><strong>
                                            <%= item.price %>
                                        </strong> <small>₹</small></p>
                                    <p class="card-text"> <small>kg</small></p>
                                    <a href="#" class="btn btn-primary">Add to Cart</a>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                </div>
        </section>
        <section class="footer-section">
            <footer class="bg-light pt-5">
                <div class="container">
                    <div class="row">
                        <div class="col-md-3 mb-4">
                            <h5>About Projects</h5>
                            <p>
                                Active Crop is an e-commerce platform designed to connect farmers directly with
                                customers, enabling
                                the sale of fresh vegetables and fruits. The core idea is to source produce directly
                                from farmers,
                                ensuring freshness and fair pricing. Customers can browse and purchase products online,
                                while
                                farmers earn 85% of each sale, with 15% retained by the platform as commission (plus
                                delivery
                                charges).
                                The project emphasizes sustainability, farmer empowerment, and customer satisfaction,
                                offering
                                transparent pricing, fast delivery, and eco-friendly practices. With features like
                                user-friendly
                                dashboards for both farmers and customers, secure payment systems, and a reliable
                                delivery network,
                                Active Crop aims to revolutionize the way people access fresh produce while supporting
                                the farming
                                community.
                            </p>
                        </div>
                        <div class="col-md-3 mb-4">
                            <h5>Get To Know Us</h5>
                            <ul>
                                <li>About Us</li>
                                <li>Our Farmers</li>
                                <li>Gallery</li>
                                <li>Media</li>
                                <li>Blog</li>
                            </ul>
                        </div>
                        <div class="col-md-3 mb-4">
                            <h5>Useful Links</h5>
                            <ul>
                                <li>Privacy Policy</li>
                                <li>Refun & Refund Policy</li>
                                <li>Ship and Delivery policy</li>
                                <li>Terms & Condtitions</li>
                                <li>Disclaimer</li>
                                <li>Carrers</li>
                            </ul>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col text-center py-3">
                            <p class="mb-0">&copy; 2024 Active Crop. All Rights Reserved.</p>
                        </div>
                    </div>
                </div>
            </footer>
        </section>
    </main>

    <script>
        function viewProduct(productId) {
            window.location.href = `/products/${productId}`;
        }
    </script>
    <script src="https://kit.fontawesome.com/88f2b93054.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>