<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>



    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="./style.css">
</head>

<body>

    <main>
        <section class="header-section">
            <header class="bg-light py-2">
                <div class="container">
                    <div class="row justify-content-end align-items-center">
                        <div class="col-auto">
                            <a href="https://wa.me/8078599537" class="text-dark" target="_blank">
                                <i class="fab fa-whatsapp"></i> 8078599537
                            </a>
                        </div>
                        <div class="col-auto">
                            <a href="tel:8078599537" class="text-dark">
                                <i class="fas fa-headset"></i> 8078599537
                            </a>
                        </div>
                        <div class="col-auto">
                            <a href="chat.html" class="text-dark">
                                <i class="fas fa-comments"></i> Chat
                            </a>
                        </div>
                        <div class="col-auto">
                            <a href="login.html" class="btn btn-primary">Login</a>
                        </div>
                    </div>
                </div>
            </header>
            <div class="bg-light py-3">
                <div class="container">
                    <div class="row justify-content-between align-items-center">
                        <div class="col">
                            <i class="fas fa-leaf"></i> Active Crop
                        </div>
                        <div class="col">
                            <form class="form-inline">
                                <input class="form-control mr-2" type="search" placeholder="Search" aria-label="Search">
                                <button class="btn btn-outline-success mr-2" type="submit">Search</button>
                                <a href="cart.html" class="btn btn-outline-primary">
                                    <i class="fas fa-shopping-cart"></i> Cart
                                </a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="body-section">
            <div class="container mt-5">
                <h1 class="mb-4">
                    <%= product.product_name %>
                </h1>
                <div class="row">
                    <div class="col-md-6">
                        <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner zoom-container">
                                <% Object.values(product.images).forEach(function(image, index) { %>
                                    <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                        <img src="/<%= image %>" class="d-block w-100" alt="Product Image"
                                            id="zoomed-image-<%= index %>">
                                    </div>
                                    <% }); %>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel"
                                data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#productCarousel"
                                data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h3>Description</h3>
                        <p>
                            <%= product.description %>
                        </p>
                        <h3>Price and Units</h3>
                        <p><strong>
                                <%= product.price %>₹
                            </strong> <small>
                                <%= product.stock_quentity %> kg
                            </small></p>
                        <a href="#" class="btn btn-primary">Add to Cart</a>
                    </div>
                </div>
            </div>
        </section>
        <section class="footer-section">


            <!-- Footer Section -->
            <footer class="bg-light pt-5">
                <div class="container">
                    <div class="row">
                        <div class="col-md-3 mb-4">
                            <h5>About Projects</h5>
                            <p>Active Crop is an e-commerce platform designed to connect farmers directly with
                                customers, enabling the sale of fresh vegetables and fruits...</p>
                        </div>
                        <div class="col-md-3 mb-4">
                            <h5>Column 1</h5>
                            <ul class="list-unstyled">
                                <li><a href="#">Item 1</a></li>
                                <li><a href="#">Item 2</a></li>
                                <li><a href="#">Item 3</a></li>
                                <li><a href="#">Item 4</a></li>
                            </ul>
                        </div>
                        <div class="col-md-3 mb-4">
                            <h5>Column 2</h5>
                            <ul class="list-unstyled">
                                <li><a href="#">Item 1</a></li>
                                <li><a href="#">Item 2</a></li>
                                <li><a href="#">Item 3</a></li>
                                <li><a href="#">Item 4</a></li>
                            </ul>
                        </div>
                        <div class="col-md-3 mb-4">
                            <h5>Column 3</h5>
                            <ul class="list-unstyled">
                                <li><a href="#">Item 1</a></li>
                                <li><a href="#">Item 2</a></li>
                                <li><a href="#">Item 3</a></li>
                                <li><a href="#">Item 4</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col text-center py-3">
                            <p class="mb-0">&copy; 2024 Active Crop. All Rights Reserved.</p>
                        </div>
                    </div>
                </div>
            </footer>
        </section>
    </main>


    <script src="https://kit.fontawesome.com/88f2b93054.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
</body>

</html>