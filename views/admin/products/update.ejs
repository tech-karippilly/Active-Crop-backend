<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Crop | Product</title>
    <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

    <link href="/public/styles/dashboard.css" rel="stylesheet" type="text/css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
</head>

<body>
    <div class="alert-box" id="alert-box"></div>
    <% if (alertMessage) { %>
        <div class="alert alert-<%= alertType %>" id="alert">
            <%= alertMessage %>
        </div>
        <% } %>
            </div>
            <div class="main-container">
                <section class="side-bar">
                    <div class="side-bar-heading">
                        <h1>ADMIN</h1>
                    </div>
                    <div class="side-bar-menu" id="menuId">
                        <div class="link-container">
                            <a href="/page/dashboard" class="link-text">Dashboard</a>
                        </div>
                        <div class="link-container">
                            <a href="/page/admin/product" class="link-text-active">Products</a>
                        </div>
                        <div class="link-container">
                            <a href="/page/admin/catagoery" class="link-text">Categoery</a>
                        </div>
                        <div class="link-container">
                            <a href="#" class="link-text">Orders</a>
                        </div>
                        <div class="link-container">
                            <a href="#" class="link-text">Coupons</a>
                        </div>
                        <div class="link-container">
                            <a href="/page/admin/customer" class="link-text">Customers</a>
                        </div>
                        <div class="link-container">
                            <a href="#" class="link-text">Banner</a>
                        </div>
                        <div class="link-container">
                            <a href="#" class="link-text">Transactions</a>
                        </div>
                        <div class="link-container">
                            <a href="#" class="button-link">Logout</a>
                        </div>
                    </div>
                </section>
                <section class="container-section p-5  w-100">

                    <div class="container-fluid  w-100">
                        <div>
                            <h1>Update Product</h1>
                        </div>

                        <div class="catagoery-form">
                            
        <form id="create-category-form" enctype="multipart/form-data">
            <div class="row">
                <% Object.values(product.images).forEach(function(image) { %>
                    <div class="col-md-3 mb-4">
                        <div class="card">
                            <img src="/<%= image %>" class="card-img-top product-img" alt="Product Image">
                        </div>
                    </div>
                <% }); %>
            </div>
            <div class="row">
                <div class="col">
                    <label for="product_image1" class="form-label">Select Product Image</label>
                    <input class="form-control" type="file" name="product_image1" id="formFile1">
                </div>
                <div class="col">
                    <label for="product_image2" class="form-label">Select Product Image</label>
                    <input class="form-control" type="file" name="product_image2" id="formFile2">
                </div>
                <div class="col">
                    <label for="product_image3" class="form-label">Select Product Image</label>
                    <input class="form-control" type="file" name="product_image3" id="formFile3">
                </div>
                <div class="col">
                    <label for="product_image4" class="form-label">Select Product Image</label>
                    <input class="form-control" type="file" name="product_image4" id="formFile4">
                </div>
            </div>
            <div class="mb-3">
                <label for="product_name" class="form-label label-text">Product Name</label>
                <input type="text" class="form-control" name="product_name" id="productName">
            </div>
            <div class="mb-3">
                <label for="price" class="form-label label-text">Product Price</label>
                <input type="text" class="form-control" name="price" id="price">
            </div>
            <div class="mb-3">
                <label for="stock_quantity" class="form-label label-text">Stock Quantity</label>
                <input type="text" class="form-control" name="stock_quantity" id="stockQuantity">
            </div>
            <div class="mb-3">
                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton1"
                        data-bs-toggle="dropdown" aria-expanded="false">
                        Category Name
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                        <% categories.forEach(function(category) { %>
                            <li><a class="dropdown-item" href="#"
                                    onclick="selectCategory('<%= category._id %>', '<%= category.catagoery_name %>')">
                                    <%= category.catagoery_name %></a></li>
                        <% }); %>
                    </ul>
                </div>
                <input type="hidden" name="category_id" id="categoryId">
            </div>
            <div class="mb-3">
                <div class="form-floating">
                    <textarea class="form-control" placeholder="Leave description" name="description"
                        id="description" style="height: 100px"></textarea>
                    <label for="description">Description</label>
                </div>
            </div>
            <div class="btn-container">
                <button type="submit" class="btn button-style">Update Product</button>
            </div>
        
                        </div>
                    </div>

                </section>
            </div>


            <script>
                const alertBox = document.getElementById('alert-box')
                setTimeout(() => {
                    alertBox.classList = '';
                    alertBox.innerHTML = '';
                }, 3000);

                const redirectUrl = "<%= redirectUrl %>";
                if (redirectUrl && redirectUrl.trim() !== "") {
                    console.log(redirectUrl)
                    setTimeout(() => {
                        window.location.href = redirectUrl;
                    }, 2000)

                }
                function selectCategory(category) {
                    document.getElementById('categoryName').value = category;
                    document.getElementById('dropdownMenuButton1').innerText = category;
                }
                document.getElementById('create-category-form').onsubmit = async function (event) {
            event.preventDefault();

            const formData = new FormData(this);
            const imageUrl = "/<%= product.images['0'] %>";

            for (let i = 1; i <= 4; i++) {
                const imageFile = document.getElementById(`formFile${i}`).files[0];
                if (!imageFile) {
                    const response = await fetch(imageUrl);
                    const blob = await response.blob();
                    const file = new File([blob], 'default-image.jpg', { type: blob.type });
                    formData.append(`product_image${i}`, file);
                }
            }

            fetch(`/api/products/<%= product._id %>`, {
                method: 'PUT',
                body: formData,
            })
                .then(response => response.json())
                .then(data => {
                    const alertBox = document.getElementById('alert-box');
                    alertBox.innerHTML = `
                        <div class="alert alert-success" id="alert">
                            ${data.message}
                        </div>
                    `;
                    setTimeout(() => {
                        alertBox.innerHTML = '';
                        window.location.href = '/api/products/';
                    }, 5000);
                })
                .catch(error => console.error('Error:', error));
        }
            </script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
                crossorigin="anonymous"></script>
</body>

</html>